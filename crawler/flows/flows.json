    "privacyChoiceXPath": "//button[img[@alt='privacy options'] and contains(., 'Your Privacy Choices')]",
    "requiresReload": true,
    "rejectSelector": "button.ot-pc-refuse-all-handler"
  },
  "https://www.state.gov": {
    "acceptSelector": "button#ez-cookie-notification__accept",
    "denySelector": "button#ez-cookie-notification__decline",
    "privacyChoiceXPath": "//button[img[@alt='privacy options'] and contains(., 'Your Privacy Choices')]",
    "requiresReload": true
  },
  "https://www.amazon.com/": {
    "acceptSelector": "button#ez-cookie-notification__accept",
    "denySelector": "button#ez-cookie-notification__decline",
    "privacyChoiceXPath": "//a[text()='Your Ads Privacy Choices']",
    "requiresReload": true,
    "rejectSelector": "#cross-context-behavioral-ads-opt-out",
    "SaveButtonSelector": "#a-autoid-0"
